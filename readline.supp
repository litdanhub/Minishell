{
   readline_libreadline_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libreadline.so*
   ...
   fun:readline
   ...
}

{
   readline_libtinfo_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libtinfo.so*
   ...
   fun:_rl_init_terminal_io
   fun:rl_initialize
   fun:readline
   ...
}

{
   readline_history_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:add_history
   ...
}

{
   readline_bracketed_paste_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libreadline.so*
   ...
   fun:rl_extend_line_buffer
   fun:rl_insert_text
   fun:rl_bracketed_paste_begin
   ...
}